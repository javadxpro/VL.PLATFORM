# ============================================================
#  Volexturn — environment configuration (copy to `.env`)
# ============================================================
#  Only what the app actually reads is listed here; the value shown next to
#  each key is the built-in default, so an empty file is a working config.
#  Read order: real environment variables > this file > defaults.
#
#  ⚠️  `.env` is listed in .gitignore and must never be committed: it holds
#  the signing key, and that key is what makes session tokens unforgeable.

# ---------- runtime ----------
VOLEXTURN_ENV=development          # development | production  (FLASK_ENV also honoured)
VOLEXTURN_DEV_MODE=0               # 1 = verbose errors; forced off when ENV=production
VOLEXTURN_HOST=0.0.0.0
PORT=5000                          # VOLEXTURN_PORT is honoured too
VOLEXTURN_IS_SECURE=0              # 1 behind TLS: sets the cookie Secure flag
VOLEXTURN_URL_SCHEME=http          # used when building absolute links
VOLEXTURN_ALLOWED_HOSTS=           # comma list; empty means "any Host header"
VOLEXTURN_TRUST_XFF=0              # 1 ONLY behind a proxy that sets X-Forwarded-For
                                   #   (otherwise anyone can spoof their rate-limit key)

# ---------- secrets & accounts ----------
# 32+ chars, random. Required in production: with ENV=production and no key set
# the app refuses to start rather than ship an ephemeral signing key.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VOLEXTURN_SECRET_KEY=
# First admin's password, consumed once by the setup flow. Prefer the CLI:
#   python -m backend create-admin -u root -p 'a-long-passphrase'
VOLEXTURN_ADMIN_PASSWORD=
VOLEXTURN_SESSION_TTL_DAYS=30      # sessions expire; there is no "forever" cookie
VOLEXTURN_SESSION_MAX_PER_USER=5   # oldest sessions are revoked past this
VOLEXTURN_MIN_PASSWORD_LENGTH=8
VOLEXTURN_PBKDF2_ITERATIONS=240000 # old hashes are re-hashed on login, never rejected
VOLEXTURN_LOGIN_MAX_ATTEMPTS=8     # per window, per user+IP
# how long the login attempt buckets keep counting
VOLEXTURN_LOGIN_WINDOW_SECONDS=300

# ---------- database ----------
# sqlite (default) needs only a path; `postgres` is chosen automatically when
# DATABASE_URL is set.
VOLEXTURN_DB_ENGINE=sqlite
VOLEXTURN_DB_PATH=database.db
# DATABASE_URL=postgresql://user:password@host:5432/volexturn

# ---------- uploads ----------
VOLEXTURN_UPLOAD_FOLDER=uploads
VOLEXTURN_MAX_IMAGE_MB=5
VOLEXTURN_MAX_VIDEO_MB=10
VOLEXTURN_MAX_FILE_MB=50
VOLEXTURN_MAX_AVATAR_MB=3
# Files are stored under generated names and served from /files/<category>/<name>;
# the type is decided by magic bytes, never by what the browser claimed.

# ---------- api shape ----------
VOLEXTURN_PAGE_SIZE=20
VOLEXTURN_MAX_PAGE_SIZE=100
VOLEXTURN_RATE_LIMITS=1            # 0 disables throttling (tests/debug only)
VOLEXTURN_RATE_CAPACITY=120        # burst allowed per endpoint
VOLEXTURN_RATE_WINDOW=60           # seconds the budget refills over

# ---------- background janitor & LAN discovery ----------
VOLEXTURN_JANITOR_INTERVAL=60      # sweep cadence: expired stories, stale servers,
                                   # orphaned media, dead sessions
VOLEXTURN_HEARTBEAT_TIMEOUT=180    # a hosted server with no heartbeat becomes offline
VOLEXTURN_OFFLINE_GRACE=86400      # how long an offline server stays before archiving
VOLEXTURN_ROOM_STALE_MINUTES=720   # empty game rooms auto-close
# ⚠️  Keep this off unless you specifically want active probing. When enabled,
# probes only reach LITERAL IPs inside the allowlist below — no scanning, no
# broadcast, and metadata/reserved addresses are always refused (SSRF).
VOLEXTURN_DISCOVERY_ENABLED=0
VOLEXTURN_DISCOVERY_NETWORKS=      # e.g. 192.168.0.0/16,10.0.0.0/8
VOLEXTURN_DISCOVERY_INTERVAL=60
VOLEXTURN_DISCOVERY_TIMEOUT=1.5

# ---------- logging ----------
VOLEXTURN_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
VOLEXTURN_LOG_JSON=1               # 1 = structured lines (for a log shipper)
