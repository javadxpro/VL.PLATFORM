{
    "name": "Volexturn Super-App",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "postCreateCommand": "pip install -r requirements.txt",
    "forwardPorts": [5000],
    "portsAttributes": {
        "5000": {
            "label": "Volexturn Web App",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "codespaces": {
            "openFiles": ["README.md", "CODESPACE.md"]
        }
    },
    "remoteUser": "vscode"
}
